FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "Acquire::Retries \"3\";" > /etc/apt/apt.conf.d/80-retries && \
    echo "Acquire::http::Timeout \"60\";" >> /etc/apt/apt.conf.d/80-retries && \
    echo "Acquire::https::Timeout \"60\";" >> /etc/apt/apt.conf.d/80-retries && \
    echo "Acquire::http::No-Cache true;" >> /etc/apt/apt.conf.d/80-retries && \
    echo "Acquire::BrokenProxy true;" >> /etc/apt/apt.conf.d/80-retries

RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirror.math.princeton.edu/pub/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources && \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirror.math.princeton.edu/pub/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources

# Install build dependencies (this layer will be cached)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    wget \
    pkg-config \
    libssl-dev \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy build scripts and setup scripts first
COPY scripts/build/ /workspace/scripts/build/
COPY scripts/setup/ /workspace/scripts/setup/
RUN chmod +x /workspace/scripts/build/*.sh /workspace/scripts/setup/*.sh

# Install ROS 2 Jazzy (will be cached after first build)
RUN /workspace/scripts/build/build_ros2_jazzy.sh

# Build OQS (will be cached after first build)
RUN /workspace/scripts/build/build_oqs.sh \
    -p /opt/oqs_openssl3 \
    -j $(nproc)

# Build SROS2 with Post-Quantum support using the new build script
RUN /workspace/scripts/build/build_sros2.sh \
    -p /opt/ros2_workspace \
    -t Release \
    -j $(nproc) \
    --force

# Copy remaining scripts
COPY scripts/ /workspace/scripts/
RUN chmod +x /workspace/scripts/**/*.sh

# Create workspace directories
RUN mkdir -p /workspace/certs /workspace/config

# Create convenience script to setup SROS2 environment
RUN ln -sf /workspace/scripts/setup/setup_sros2_env.sh /workspace/setup_sros2

# Verify SROS2 installation
RUN bash -c "source /workspace/scripts/setup/setup_sros2_env.sh && ros2 security --help" || \
    echo "SROS2 verification failed, but installation completed"

CMD ["/bin/bash"]