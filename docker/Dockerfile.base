ARG ROS_DISTRO=lyrical
FROM ros:${ROS_DISTRO}-ros-base

ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS_DISTRO} \
    SROS2_OVERLAY=/opt/sros2-overlay

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        libssl-dev \
        ninja-build \
        openssl \
        pkg-config \
        python3-colcon-common-extensions \
        python3-cryptography \
        python3-lxml \
        python3-pip \
        python3-pytest \
        python3-vcstool \
        ros-${ROS_DISTRO}-demo-nodes-cpp \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-rmw-zenoh-cpp \
        ros-${ROS_DISTRO}-sros2 \
        rustc \
        cargo \
    && rm -rf /var/lib/apt/lists/*

# Build this checkout of the rebased SROS2 fork as an overlay. OpenSSL 3.5 is
# supplied by Ubuntu 26.04 in the Lyrical image; no oqsprovider is required.
COPY sros2 /opt/sros2-src
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && cd /opt/sros2-src \
    && colcon build \
        --install-base "${SROS2_OVERLAY}/install" \
        --build-base "${SROS2_OVERLAY}/build" \
        --packages-select sros2 sros2_cmake \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && openssl list -signature-algorithms | grep -q ML-DSA-44

WORKDIR /workspace
COPY config /workspace/config
COPY demos /workspace/demos
COPY scripts /workspace/scripts
RUN find /workspace/scripts -type f -name '*.sh' -exec chmod +x {} + \
    && mkdir -p /workspace/certs

CMD ["bash"]
