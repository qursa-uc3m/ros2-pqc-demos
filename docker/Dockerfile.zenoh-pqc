ARG BASE_IMAGE=ros2-pqc-demos:base
FROM ${BASE_IMAGE} AS builder

ARG ZENOH_COMMIT=2687c51352121f006e3a603ce07925a8ad0b295c
ARG ZENOHC_COMMIT=05bd370343b5161ca9269649b9a914c9c2dc4170
ARG ZENOHCXX_COMMIT=481b71bf974f684ea75afb4243b0313646d545f9
ARG RMW_ZENOH_COMMIT=0ea90273de3570ceb806c80c2fd7b42d4de72940

ENV ZENOH_PQC_PREFIX=/opt/zenoh-pqc \
    RMW_ZENOH_OVERLAY=/opt/rmw-zenoh-overlay \
    RMW_IMPLEMENTATION=rmw_zenoh_cpp

COPY patches/zenoh-rustls-aws-lc-pqc.patch /opt/patches/zenoh-rustls-aws-lc-pqc.patch
COPY patches/rmw-zenoh-security-tools.patch /opt/patches/rmw-zenoh-security-tools.patch
COPY scripts/build/build_zenoh_pqc.sh /opt/build_zenoh_pqc.sh

RUN /opt/build_zenoh_pqc.sh \
        "${ZENOH_COMMIT}" \
        "${ZENOHC_COMMIT}" \
        "${ZENOHCXX_COMMIT}" \
        "${RMW_ZENOH_COMMIT}" \
        "${ZENOH_PQC_PREFIX}" \
        "${RMW_ZENOH_OVERLAY}" core

# Keep the expensive Rust/C build in a separate cacheable layer so failures in
# the much smaller ROS overlay build do not force a complete rebuild.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/build_zenoh_pqc.sh \
        "${ZENOH_COMMIT}" \
        "${ZENOHC_COMMIT}" \
        "${ZENOHCXX_COMMIT}" \
        "${RMW_ZENOH_COMMIT}" \
        "${ZENOH_PQC_PREFIX}" \
        "${RMW_ZENOH_OVERLAY}" rmw

FROM ${BASE_IMAGE}

ENV ZENOH_PQC_PREFIX=/opt/zenoh-pqc \
    RMW_ZENOH_OVERLAY=/opt/rmw-zenoh-overlay \
    RMW_IMPLEMENTATION=rmw_zenoh_cpp

COPY --from=builder /opt/zenoh-pqc /opt/zenoh-pqc
COPY --from=builder /opt/rmw-zenoh-overlay/install /opt/rmw-zenoh-overlay/install

CMD ["bash"]
