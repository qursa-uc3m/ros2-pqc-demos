<?xml version="1.0" encoding="utf-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stdout</OutputFile>
    </Tracing>
    <Security>
      <Authentication>
        <Library initFunction="init_authentication"
          finalizeFunction="finalize_authentication" path="dds_pqsec"/>
        <IdentityCA>file:/workspace/certs/keystore/public/identity_ca.cert.pem</IdentityCA>
        <IdentityCertificate>file:/workspace/certs/keystore/enclaves/talker_listener/listener/cert.pem</IdentityCertificate>
        <PrivateKey>file:/workspace/certs/keystore/enclaves/talker_listener/listener/key.pem</PrivateKey>
      </Authentication>
      <Cryptographic>
        <Library initFunction="init_crypto"
          finalizeFunction="finalize_crypto" path="dds_security_crypto"/>
      </Cryptographic>
      <AccessControl>
        <Library initFunction="init_access_control"
          finalizeFunction="finalize_access_control" path="dds_security_ac"/>
        <PermissionsCA>file:/workspace/certs/keystore/public/permissions_ca.cert.pem</PermissionsCA>
        <Governance>file:/workspace/certs/keystore/enclaves/governance.p7s</Governance>
        <Permissions>file:/workspace/certs/keystore/enclaves/talker_listener/listener/permissions.p7s</Permissions>
      </AccessControl>
    </Security>
  </Domain>
</CycloneDDS>
