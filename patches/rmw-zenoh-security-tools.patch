+//==============================================================================
+// Zenoh expands endpoint settings into either arrays or mode-keyed objects.
+// Walk both representations so every configured endpoint uses TLS.
+void replace_endpoint_transports(json & endpoints)
+{
+  if (endpoints.is_string()) {
+    std::string endpoint = endpoints.get<std::string>();
+    const std::size_t slash_pos = endpoint.find('/');
+    if (slash_pos == std::string::npos) {
+      throw std::runtime_error("Zenoh endpoint has no transport prefix: " + endpoint);
+    }
+    endpoints = endpoint.replace(0, slash_pos, "tls");
+    return;
+  }
+  if (endpoints.is_array() || endpoints.is_object()) {
+    for (json & endpoint : endpoints) {
+      replace_endpoint_transports(endpoint);
+    }
+    return;
+  }
+  if (!endpoints.is_null()) {
+    throw std::runtime_error("Zenoh endpoints must be strings, arrays, or objects");
+  }
+}
